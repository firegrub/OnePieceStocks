@model OnePieceStocks.Models.Character

@{
    ViewData["Title"] = "Create";
}

<h1>Create Character</h1>

<h4>Character</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImagePath" class="control-label">Image Path</label>
                <input asp-for="ImagePath" class="form-control" />
                <span asp-validation-for="ImagePath" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CurrentPrice" class="control-label"></label>
                <input asp-for="CurrentPrice" class="form-control" />
                <span asp-validation-for="CurrentPrice" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="MaxStockUnits" class="control-label">Max Stock Units</label>
                <input asp-for="MaxStockUnits" class="form-control" />
                <span asp-validation-for="MaxStockUnits" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Bounty" class="control-label"></label>
                <input asp-for="Bounty" class="form-control" />
                <span asp-validation-for="Bounty" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsDead" class="control-label"></label>
                <input asp-for="IsDead" class="form-check-input" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-check-input" />
            </div>

            <hr />

            <div class="form-group mb-3">
                <label asp-for="LifetimeIncreaseAmount" class="control-label"></label>
                <input asp-for="LifetimeIncreaseAmount" class="form-control" />
                <span asp-validation-for="LifetimeIncreaseAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LifetimeDecreaseAmount" class="control-label"></label>
                <input asp-for="LifetimeDecreaseAmount" class="form-control" />
                <span asp-validation-for="LifetimeDecreaseAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="WeeklyIncreaseAmount" class="control-label"></label>
                <input asp-for="WeeklyIncreaseAmount" class="form-control" />
                <span asp-validation-for="WeeklyIncreaseAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="WeeklyDecreaseAmount" class="control-label"></label>
                <input asp-for="WeeklyDecreaseAmount" class="form-control" />
                <span asp-validation-for="WeeklyDecreaseAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LifetimeIncreaseCount" class="control-label"></label>
                <input asp-for="LifetimeIncreaseCount" class="form-control" />
                <span asp-validation-for="LifetimeIncreaseCount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LifetimeDecreaseCount" class="control-label"></label>
                <input asp-for="LifetimeDecreaseCount" class="form-control" />
                <span asp-validation-for="LifetimeDecreaseCount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="WeeklyIncreaseCount" class="control-label"></label>
                <input asp-for="WeeklyIncreaseCount" class="form-control" />
                <span asp-validation-for="WeeklyIncreaseCount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="WeeklyDecreaseCount" class="control-label"></label>
                <input asp-for="WeeklyDecreaseCount" class="form-control" />
                <span asp-validation-for="WeeklyDecreaseCount" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}