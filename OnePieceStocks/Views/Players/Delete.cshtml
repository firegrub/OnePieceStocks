@model OnePieceStocks.Models.Player

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Player</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Player</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Linked Username</dt>
        <dd class="col-sm-10">@ViewBag.LinkedUsername</dd>

        <dt class="col-sm-2">Wallet</dt>
        <dd class="col-sm-10">@Model.Wallet</dd>

        <dt class="col-sm-2">Total Slots</dt>
        <dd class="col-sm-10">@Model.TotalSlots</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>