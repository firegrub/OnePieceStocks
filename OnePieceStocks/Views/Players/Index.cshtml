@model IEnumerable<OnePieceStocks.Models.Player>

@{
    ViewData["Title"] = "Players";
}

<h1>Players</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Wallet</th>
            <th>Total Slots</th>
            <th>Notes</th>
            <th>Is Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
            <td>@item.Wallet</td>
            <td>@item.TotalSlots</td>
            <td>@item.Notes</td>
            <td>@item.IsActive</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Admin"))
                {
                    <span> | </span><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <span> | </span><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>