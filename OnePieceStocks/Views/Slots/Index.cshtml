@using OnePieceStocks.Models
@{
    ViewData["Title"] = "Slots";
    Player? player = ViewBag.CurrentPlayer as Player;
    int usedSlots = ViewBag.UsedSlots ?? 0;
    decimal? nextBuyCost = ViewBag.NextBuyCost as decimal?;
    decimal nextSellValue = ViewBag.NextSellValue ?? 0m;
}

<h1>Slots</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (ViewBag.NoLinkedPlayer == true)
{
    <div class="alert alert-danger">No player account is linked to this username.</div>
}
else if (User.IsInRole("Admin"))
{
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Buy" method="post" class="mb-4">
                <div class="form-group mb-3">
                    <label class="control-label">Player</label>
                    <select name="playerId" class="form-control" asp-items="ViewBag.PlayerId"></select>
                </div>
                <button type="submit" class="btn btn-primary">Buy Next Slot</button>
            </form>

            <form asp-action="Sell" method="post">
                <div class="form-group mb-3">
                    <label class="control-label">Player</label>
                    <select name="playerId" class="form-control" asp-items="ViewBag.PlayerId"></select>
                </div>
                <button type="submit" class="btn btn-danger">Sell Current Highest Slot</button>
            </form>
        </div>
    </div>
}
else if (player != null)
{
    <div class="mb-3">
        <p><strong>Player:</strong> @player.Name</p>
        <p><strong>Wallet:</strong> @player.Wallet.ToString("N0")</p>
        <p><strong>Total Slots:</strong> @player.TotalSlots</p>
        <p><strong>Used Slots:</strong> @usedSlots</p>
        <p><strong>Free Slots:</strong> @(player.TotalSlots - usedSlots)</p>
        <p><strong>Next Buy Cost:</strong> @(nextBuyCost.HasValue ? nextBuyCost.Value.ToString("N0") : "No more slots available")</p>
        <p><strong>Sell Value of Current Highest Slot:</strong> @nextSellValue.ToString("N0")</p>
    </div>

    <form asp-action="Buy" method="post" class="mb-3">
        <input type="hidden" name="playerId" value="@player.Id" />
        <button type="submit" class="btn btn-primary">Buy Next Slot</button>
    </form>

    <form asp-action="Sell" method="post">
        <input type="hidden" name="playerId" value="@player.Id" />
        <button type="submit" class="btn btn-danger">Sell Current Highest Slot</button>
    </form>
}