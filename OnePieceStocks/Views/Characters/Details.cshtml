@model OnePieceStocks.Models.Character

@{
    ViewData["Title"] = "Character Details";
}

<h1>@Model.Name</h1>

<hr />

<div>
    <p><strong>Current Price:</strong> @Model.CurrentPrice.ToString("N0")</p>
    <p><strong>Bounty:</strong> @Model.Bounty.ToString("N0")</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
    <p><strong>Dead:</strong> @Model.IsDead</p>
    <p><strong>Active:</strong> @Model.IsActive</p>
</div>

<hr />

<h4>Stats</h4>
<p><strong>Lifetime Increase Amount:</strong> @Model.LifetimeIncreaseAmount.ToString("N0")</p>
<p><strong>Lifetime Decrease Amount:</strong> @Model.LifetimeDecreaseAmount.ToString("N0")</p>
<p><strong>Weekly Increase Amount:</strong> @Model.WeeklyIncreaseAmount.ToString("N0")</p>
<p><strong>Weekly Decrease Amount:</strong> @Model.WeeklyDecreaseAmount.ToString("N0")</p>
<p><strong>Lifetime Increase Count:</strong> @Model.LifetimeIncreaseCount</p>
<p><strong>Lifetime Decrease Count:</strong> @Model.LifetimeDecreaseCount</p>
<p><strong>Weekly Increase Count:</strong> @Model.WeeklyIncreaseCount</p>
<p><strong>Weekly Decrease Count:</strong> @Model.WeeklyDecreaseCount</p>

<hr />

<h4>Price History Graph</h4>
<canvas id="priceChart" height="120"></canvas>

<hr />

<h4>Price History Table</h4>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Old Price</th>
            <th>New Price</th>
            <th>Direction</th>
            <th>Mode</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.PriceHistories.OrderByDescending(p => p.Date))
{
        <tr>
            <td>@item.Date.ToLocalTime()</td>
            <td>@item.OldPrice.ToString("N0")</td>
            <td>@item.NewPrice.ToString("N0")</td>
            <td>@item.ChangeDirection</td>
            <td>@item.ChangeMode</td>
            <td>@item.Notes</td>
        </tr>
}
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index">Back to Characters</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PriceHistoryLabels));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PriceHistoryValues));

        const ctx = document.getElementById('priceChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Price',
                    data: values,
                    fill: false,
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}