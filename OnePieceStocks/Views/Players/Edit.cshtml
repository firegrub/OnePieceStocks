@model OnePieceStocks.Models.Player

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Player</h1>

<h4>Player</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                 <label asp-for="UserId" class="control-label">Linked Username</label>
                 <input asp-for="UserId" class="form-control" />
                 <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Wallet" class="control-label"></label>
                <input asp-for="Wallet" class="form-control" />
                <span asp-validation-for="Wallet" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TotalSlots" class="control-label"></label>
                <input asp-for="TotalSlots" class="form-control" />
                <span asp-validation-for="TotalSlots" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProfileImagePath" class="control-label"></label>
                <input asp-for="ProfileImagePath" class="form-control" />
                <span asp-validation-for="ProfileImagePath" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-check-input" />
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}