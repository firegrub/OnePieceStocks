@model IEnumerable<OnePieceStocks.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Log";
}

<h1>Activity Log</h1>
<p class="text-muted">Auto-refreshes every 30 seconds</p>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Message</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Date.ToLocalTime()</td>
            <td>@item.ActivityType</td>
            <td>@item.Message</td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        setTimeout(function () {
            location.reload();
        }, 30000);
    </script>
}